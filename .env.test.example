# Live-provider credentials for the assistant e2e run. Committed as a template only —
# copy to `.env.test` and fill in a key there. `.env.test` is git-ignored.
#
#   cp .env.test.example .env.test
#
# Nothing here is needed for the ordinary suite: `npm run test:e2e` stubs the provider with
# canned responses and makes no network call. This file exists for the one spec that asks a
# REAL model to decide for itself which tool to call — the thing a canned response cannot test.
# Without a key that spec skips; the rest of the suite is unaffected.

# Which provider the live spec uses: anthropic | openai
LEDGER_LIVE_PROVIDER=anthropic

# The model id, sent verbatim. Both providers must support tool calling — the app gates the
# assistant behind a probe that requires it, so a model without tools fails at setup.
#
#   anthropic  claude-opus-5      most capable, $5/$25 per Mtok
#              claude-sonnet-5    $3/$15
#              claude-haiku-4-5   $1/$5 — the cheap option for repeated runs
#   openai     whatever your account can reach; it must support tool calling
LEDGER_LIVE_MODEL=claude-opus-5

# Only the key for LEDGER_LIVE_PROVIDER is read. Leave the other blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
